{
	Tools = ordered() {
		CineFocus = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input = InstanceInput {
					SourceOp = "ZoomXf",
					Source = "Input",
				},
				EditMode = Input { Value = 0, },
				AnimMode = Input { Value = 0, },
				FrameRate = Input { Value = 1, },
				Amount = Input { Value = 1, },
				FrameCenter = InstanceInput {
					SourceOp = "GuideRect",
					Source = "Center",
					Name = "Target Center (drag to move)",
				},
				FrameWidth = InstanceInput {
					SourceOp = "GuideRect",
					Source = "Width",
					Name = "Target Width",
				},
				FrameHeight = InstanceInput {
					SourceOp = "GuideRect",
					Source = "Height",
					Name = "Target Height",
				},
				FitMode = Input { Value = 0, },
				Padding = Input { Value = 0, },
				KeepInside = Input { Value = 0, },
				MaxZoom = Input { Value = 8, },
				StartDelay = Input { Value = 0.5, },
				ZoomInDur = Input { Value = 1.5, },
				HoldDur = Input { Value = 2, },
				AfterHold = Input { Value = 0, },
				ZoomOutDur = Input { Value = 1.5, },
				EaseStyle = Input { Value = 3, },
				PanLead = Input { Value = 0.25, },
				ZoomCalc = Input {
					Value = 2,
					Expression = "min(CineFocus.MaxZoom, max(1, 1 / ((max(max(0.01, abs(CineFocus.FrameWidth)), max(0.01, abs(CineFocus.FrameHeight))) * (1 - CineFocus.FitMode) + min(max(0.01, abs(CineFocus.FrameWidth)), max(0.01, abs(CineFocus.FrameHeight))) * CineFocus.FitMode) * (1 + CineFocus.Padding))))",
				},
				ViewCenter = Input {
					Value = { 0.5, 0.5 },
					Expression = "Point(CineFocus.FrameCenter.X + CineFocus.KeepInside * (min(max(CineFocus.FrameCenter.X, 0.5 / CineFocus.ZoomCalc), 1 - 0.5 / CineFocus.ZoomCalc) - CineFocus.FrameCenter.X), CineFocus.FrameCenter.Y + CineFocus.KeepInside * (min(max(CineFocus.FrameCenter.Y, 0.5 / CineFocus.ZoomCalc), 1 - 0.5 / CineFocus.ZoomCalc) - CineFocus.FrameCenter.Y))",
				},
				FPS = Input {
					Value = 24,
					Expression = "max(1,max(0,1-abs(CineFocus.FrameRate-0))*23.976+max(0,1-abs(CineFocus.FrameRate-1))*24+max(0,1-abs(CineFocus.FrameRate-2))*25+max(0,1-abs(CineFocus.FrameRate-3))*29.97+max(0,1-abs(CineFocus.FrameRate-4))*30+max(0,1-abs(CineFocus.FrameRate-5))*48+max(0,1-abs(CineFocus.FrameRate-6))*50+max(0,1-abs(CineFocus.FrameRate-7))*59.94+max(0,1-abs(CineFocus.FrameRate-8))*60)",
				},
				TimeSec = Input {
					Value = 0,
					Expression = "time / max(1,CineFocus.FPS)",
				},
				PIn = Input {
					Value = 0,
					Expression = "min(1,max(0,(CineFocus.TimeSec-CineFocus.StartDelay)/max(1,CineFocus.ZoomInDur)))",
				},
				POut = Input {
					Value = 0,
					Expression = "min(1,max(0,((CineFocus.TimeSec-CineFocus.StartDelay)-max(1,CineFocus.ZoomInDur)-CineFocus.HoldDur)/max(1,CineFocus.ZoomOutDur)))",
				},
				XZIn = Input {
					Value = 0,
					Expression = "CineFocus.PIn",
				},
				XZOut = Input {
					Value = 0,
					Expression = "CineFocus.POut",
				},
				XPIn = Input {
					Value = 0,
					Expression = "min(1,CineFocus.PIn*(1+CineFocus.PanLead))",
				},
				XPOut = Input {
					Value = 0,
					Expression = "min(1,CineFocus.POut*(1+CineFocus.PanLead))",
				},
				EZIn = Input {
					Value = 0,
					Expression = "max(0,1-abs(CineFocus.EaseStyle-0))*(CineFocus.XZIn)+max(0,1-abs(CineFocus.EaseStyle-1))*(0.5*(CineFocus.XZIn)+0.5*((CineFocus.XZIn)*(CineFocus.XZIn)*(3-2*(CineFocus.XZIn))))+max(0,1-abs(CineFocus.EaseStyle-2))*((CineFocus.XZIn)*(CineFocus.XZIn)*(3-2*(CineFocus.XZIn)))+max(0,1-abs(CineFocus.EaseStyle-3))*((CineFocus.XZIn)*(CineFocus.XZIn)*(CineFocus.XZIn)*((CineFocus.XZIn)*(6*(CineFocus.XZIn)-15)+10))+max(0,1-abs(CineFocus.EaseStyle-4))*((((CineFocus.XZIn)*(CineFocus.XZIn)*(3-2*(CineFocus.XZIn))))*(((CineFocus.XZIn)*(CineFocus.XZIn)*(3-2*(CineFocus.XZIn))))*(3-2*(((CineFocus.XZIn)*(CineFocus.XZIn)*(3-2*(CineFocus.XZIn))))))",
				},
				EZOut = Input {
					Value = 0,
					Expression = "max(0,1-abs(CineFocus.EaseStyle-0))*(CineFocus.XZOut)+max(0,1-abs(CineFocus.EaseStyle-1))*(0.5*(CineFocus.XZOut)+0.5*((CineFocus.XZOut)*(CineFocus.XZOut)*(3-2*(CineFocus.XZOut))))+max(0,1-abs(CineFocus.EaseStyle-2))*((CineFocus.XZOut)*(CineFocus.XZOut)*(3-2*(CineFocus.XZOut)))+max(0,1-abs(CineFocus.EaseStyle-3))*((CineFocus.XZOut)*(CineFocus.XZOut)*(CineFocus.XZOut)*((CineFocus.XZOut)*(6*(CineFocus.XZOut)-15)+10))+max(0,1-abs(CineFocus.EaseStyle-4))*((((CineFocus.XZOut)*(CineFocus.XZOut)*(3-2*(CineFocus.XZOut))))*(((CineFocus.XZOut)*(CineFocus.XZOut)*(3-2*(CineFocus.XZOut))))*(3-2*(((CineFocus.XZOut)*(CineFocus.XZOut)*(3-2*(CineFocus.XZOut))))))",
				},
				EPIn = Input {
					Value = 0,
					Expression = "max(0,1-abs(CineFocus.EaseStyle-0))*(CineFocus.XPIn)+max(0,1-abs(CineFocus.EaseStyle-1))*(0.5*(CineFocus.XPIn)+0.5*((CineFocus.XPIn)*(CineFocus.XPIn)*(3-2*(CineFocus.XPIn))))+max(0,1-abs(CineFocus.EaseStyle-2))*((CineFocus.XPIn)*(CineFocus.XPIn)*(3-2*(CineFocus.XPIn)))+max(0,1-abs(CineFocus.EaseStyle-3))*((CineFocus.XPIn)*(CineFocus.XPIn)*(CineFocus.XPIn)*((CineFocus.XPIn)*(6*(CineFocus.XPIn)-15)+10))+max(0,1-abs(CineFocus.EaseStyle-4))*((((CineFocus.XPIn)*(CineFocus.XPIn)*(3-2*(CineFocus.XPIn))))*(((CineFocus.XPIn)*(CineFocus.XPIn)*(3-2*(CineFocus.XPIn))))*(3-2*(((CineFocus.XPIn)*(CineFocus.XPIn)*(3-2*(CineFocus.XPIn))))))",
				},
				EPOut = Input {
					Value = 0,
					Expression = "max(0,1-abs(CineFocus.EaseStyle-0))*(CineFocus.XPOut)+max(0,1-abs(CineFocus.EaseStyle-1))*(0.5*(CineFocus.XPOut)+0.5*((CineFocus.XPOut)*(CineFocus.XPOut)*(3-2*(CineFocus.XPOut))))+max(0,1-abs(CineFocus.EaseStyle-2))*((CineFocus.XPOut)*(CineFocus.XPOut)*(3-2*(CineFocus.XPOut)))+max(0,1-abs(CineFocus.EaseStyle-3))*((CineFocus.XPOut)*(CineFocus.XPOut)*(CineFocus.XPOut)*((CineFocus.XPOut)*(6*(CineFocus.XPOut)-15)+10))+max(0,1-abs(CineFocus.EaseStyle-4))*((((CineFocus.XPOut)*(CineFocus.XPOut)*(3-2*(CineFocus.XPOut))))*(((CineFocus.XPOut)*(CineFocus.XPOut)*(3-2*(CineFocus.XPOut))))*(3-2*(((CineFocus.XPOut)*(CineFocus.XPOut)*(3-2*(CineFocus.XPOut))))))",
				},
				ZoomAmt = Input {
					Value = 0,
					Expression = "((CineFocus.EZIn-CineFocus.AfterHold*CineFocus.EZOut)*(1-CineFocus.AnimMode)+CineFocus.Amount*CineFocus.AnimMode)",
				},
				PanAmt = Input {
					Value = 0,
					Expression = "((CineFocus.EPIn-CineFocus.AfterHold*CineFocus.EPOut)*(1-CineFocus.AnimMode)+CineFocus.Amount*CineFocus.AnimMode)",
				},

			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "ResultMerge",
					Source = "Output",
				},
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ZoomXf = Transform {
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5 + (CineFocus.ViewCenter.X - 0.5) * (CineFocus.PanAmt * (1 - CineFocus.EditMode)), 0.5 + (CineFocus.ViewCenter.Y - 0.5) * (CineFocus.PanAmt * (1 - CineFocus.EditMode)))",
						},
						Size = Input {
							Value = 1,
							Expression = "pow(CineFocus.ZoomCalc, CineFocus.ZoomAmt * (1 - CineFocus.EditMode))",
						},
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				GuideColor = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 60 } },
				},
				GuideRect = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.004, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0.5, },
						Height = Input { Value = 0.5, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 60 } },
				},
				GuideMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "ZoomXf", Source = "Output", },
						Foreground = Input { SourceOp = "GuideColor", Source = "Output", },
						EffectMask = Input { SourceOp = "GuideRect", Source = "Mask", },
						Blend = Input { Value = 0, Expression = "CineFocus.EditMode", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				ResultColor = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0.9, },
						TopLeftBlue = Input { Value = 1, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 60 } },
				},
				ResultRect = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.003, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(CineFocus.ViewCenter.X, CineFocus.ViewCenter.Y)",
						},
						Width = Input { Value = 0.5, Expression = "1 / CineFocus.ZoomCalc", },
						Height = Input { Value = 0.5, Expression = "1 / CineFocus.ZoomCalc", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 60 } },
				},
				ResultMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "GuideMerge", Source = "Output", },
						Foreground = Input { SourceOp = "ResultColor", Source = "Output", },
						EffectMask = Input { SourceOp = "ResultRect", Source = "Mask", },
						Blend = Input { Value = 0, Expression = "CineFocus.EditMode", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},

			},
			UserControls = ordered() {
				EditMode = {
					LINKS_Name = "Step 1: Select Area - ON to place the box, OFF to play",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
				},
				FrameRate = {
					LINKS_Name = "Timeline Frame Rate (match your project)",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 1,
					{ CCS_AddString = "23.976 fps", },
					{ CCS_AddString = "24 fps", },
					{ CCS_AddString = "25 fps", },
					{ CCS_AddString = "29.97 fps", },
					{ CCS_AddString = "30 fps", },
					{ CCS_AddString = "48 fps", },
					{ CCS_AddString = "50 fps", },
					{ CCS_AddString = "59.94 fps", },
					{ CCS_AddString = "60 fps", },
				},
				StartDelay = {
					LINKS_Name = "Start Delay (sec from clip start)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 0.5,
					INP_MinScale = 0,
					INP_MaxScale = 10,
					INP_MinAllowed = 0,
				},
				ZoomInDur = {
					LINKS_Name = "Zoom-In Duration (sec, min 1.0)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 1.5,
					INP_MinScale = 1,
					INP_MaxScale = 8,
					INP_MinAllowed = 1,
				},
				HoldDur = {
					LINKS_Name = "Hold on Target (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 2,
					INP_MinScale = 0,
					INP_MaxScale = 30,
					INP_MinAllowed = 0,
				},
				AfterHold = {
					LINKS_Name = "After Hold",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 0,
					{ CCS_AddString = "Stay zoomed until clip ends", },
					{ CCS_AddString = "Zoom back out to full frame", },
				},
				ZoomOutDur = {
					LINKS_Name = "Zoom-Out Duration (sec, min 1.0)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 1.5,
					INP_MinScale = 1,
					INP_MaxScale = 8,
					INP_MinAllowed = 1,
				},
				EaseStyle = {
					LINKS_Name = "Motion Curve",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 3,
					{ CCS_AddString = "Linear (robotic)", },
					{ CCS_AddString = "Gentle", },
					{ CCS_AddString = "Smooth", },
					{ CCS_AddString = "Silky (recommended)", },
					{ CCS_AddString = "Cinematic (slow start/end)", },
				},
				FitMode = {
					LINKS_Name = "Fit Mode",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Advanced",
					INP_Integer = true,
					INP_Default = 0,
					{ CCS_AddString = "Fit - whole selection visible, centered", },
					{ CCS_AddString = "Fill - selection fills the frame, centered", },
				},
				Padding = {
					LINKS_Name = "Breathing Room Around Target",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Advanced",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 3,
				},
				KeepInside = {
					LINKS_Name = "Keep View Inside Image (no black edges)",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					ICS_ControlPage = "Advanced",
					INP_Integer = true,
					INP_Default = 0,
				},
				MaxZoom = {
					LINKS_Name = "Max Zoom",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Advanced",
					INP_Default = 8,
					INP_MinScale = 1,
					INP_MaxScale = 30,
					INP_MinAllowed = 1,
				},
				PanLead = {
					LINKS_Name = "Pan Lead (0 = pan & zoom together)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Advanced",
					INP_Default = 0.25,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 2,
				},
				AnimMode = {
					LINKS_Name = "Animation Mode",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Advanced",
					INP_Integer = true,
					INP_Default = 0,
					{ CCS_AddString = "Auto - timed zoom (no keyframes needed)", },
					{ CCS_AddString = "Manual - drive Zoom Amount yourself", },
				},
				Amount = {
					LINKS_Name = "Zoom Amount (Manual mode only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
