					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 1,
					INP_MinScale = 1,
					INP_MaxScale = 30,
				},
				ViewCenter = {
					LINKS_Name = "Calculated View Center (read only)",
					LINKID_DataType = "Point",
					INPID_InputControl = "OffsetControl",
					ICS_ControlPage = "Debug",
					INP_DefaultX = 0.5,
