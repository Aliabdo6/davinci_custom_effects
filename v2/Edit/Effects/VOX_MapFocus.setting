{
	Tools = ordered() {
		VOXMapFocus = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input = InstanceInput { SourceOp = "ImgXf", Source = "Input", },
				EditMode = Input { Value = 0, },
				Center = InstanceInput { SourceOp = "RegionMask", Source = "Center", Name = "Region Center (drag in viewer)", },
				Width = InstanceInput { SourceOp = "RegionMask", Source = "Width", Name = "Region Width", },
				Height = InstanceInput { SourceOp = "RegionMask", Source = "Height", Name = "Region Height", },
				DimAmount = Input { Value = 0.55, },
				DotSize = Input { Value = 0.018, },
				Pulse = Input { Value = 1, },
				PulsePeriod = Input { Value = 1.2, },
				Red = Input { Value = 0.95, },
				Green = Input { Value = 0.25, },
				Blue = Input { Value = 0.1, },
				StartDelay = Input { Value = 0, },
				FrameRate = Input { Value = 1, },
				TimeShift = Input { Value = 0, },
				FPS = Input {
					Value = 24,
					Expression = "max(1,max(0,1-abs(VOXMapFocus.FrameRate-0))*23.976+max(0,1-abs(VOXMapFocus.FrameRate-1))*24+max(0,1-abs(VOXMapFocus.FrameRate-2))*25+max(0,1-abs(VOXMapFocus.FrameRate-3))*29.97+max(0,1-abs(VOXMapFocus.FrameRate-4))*30+max(0,1-abs(VOXMapFocus.FrameRate-5))*48+max(0,1-abs(VOXMapFocus.FrameRate-6))*50+max(0,1-abs(VOXMapFocus.FrameRate-7))*59.94+max(0,1-abs(VOXMapFocus.FrameRate-8))*60)",
				},
				TimeSec = Input { Value = 0, Expression = "time/max(1,VOXMapFocus.FPS)-VOXMapFocus.TimeShift", },
				DimAmt = Input { Value = 0, Expression = "VOXMapFocus.DimAmount*(1-VOXMapFocus.EditMode)", },
				DotP = Input { Value = 1, Expression = "1+VOXMapFocus.Pulse*0.15*sin(6.28318*(VOXMapFocus.TimeSec-VOXMapFocus.StartDelay)/max(0.1,VOXMapFocus.PulsePeriod))", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "GuideMerge", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ImgXf = Transform {
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input { Value = { 0.5, 0.5 }, },
						Size = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				BlackBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 120 } },
				},
				DimMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "ImgXf", Source = "Output", },
						Foreground = Input { SourceOp = "BlackBG", Source = "Output", },
						Blend = Input { Value = 0, Expression = "VOXMapFocus.DimAmt", },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				RegionMask = RectangleMask {
					Inputs = {
						Solid = Input { Value = 1, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.35, 0.6 }, },
						Width = Input { Value = 0.22, },
						Height = Input { Value = 0.3, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 120 } },
				},
				BrightMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "DimMerge", Source = "Output", },
						Foreground = Input { SourceOp = "ImgXf", Source = "Output", },
						EffectMask = Input { SourceOp = "RegionMask", Source = "Mask", },
						Blend = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 0 } },
				},
				DotBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.95, Expression = "VOXMapFocus.Red", },
						TopLeftGreen = Input { Value = 0.25, Expression = "VOXMapFocus.Green", },
						TopLeftBlue = Input { Value = 0.1, Expression = "VOXMapFocus.Blue", },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 120 } },
				},
				DotMask = EllipseMask {
					Inputs = {
						Solid = Input { Value = 1, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXMapFocus.Center.X,VOXMapFocus.Center.Y)", },
						Width = Input { Value = 0.02, Expression = "VOXMapFocus.DotSize*VOXMapFocus.DotP", },
						Height = Input { Value = 0.02, Expression = "VOXMapFocus.DotSize*VOXMapFocus.DotP", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 120 } },
				},
				DotMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "BrightMerge", Source = "Output", },
						Foreground = Input { SourceOp = "DotBG", Source = "Output", },
						EffectMask = Input { SourceOp = "DotMask", Source = "Mask", },
						Blend = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				GuideColor = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 120 } },
				},
				GuideMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "DotMerge", Source = "Output", },
						Foreground = Input { SourceOp = "GuideColor", Source = "Output", },
						EffectMask = Input { SourceOp = "RegionMask", Source = "Mask", },
						Blend = Input { Value = 0, Expression = "VOXMapFocus.EditMode*0.35", },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 0 } },
				},
			},
			UserControls = ordered() {
				EditMode = {
					LINKS_Name = "Step 1: Select Region - ON to place, OFF to play",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
				},
				DimAmount = {
					LINKS_Name = "Dim Everything Else",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.55,
					INP_MinScale = 0,
					INP_MaxScale = 0.9,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				DotSize = {
					LINKS_Name = "Marker Dot Size (0 = off)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.018,
					INP_MinScale = 0,
					INP_MaxScale = 0.06,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 0.3,
				},
				Pulse = {
					LINKS_Name = "Marker Pulse (0 = steady)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 1,
					INP_MinScale = 0,
					INP_MaxScale = 2,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 5,
				},
				PulsePeriod = {
					LINKS_Name = "Pulse Period (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 1.2,
					INP_MinScale = 0.3,
					INP_MaxScale = 4,
					INP_MinAllowed = 0.1,
					INP_MaxAllowed = 20,
				},
				StartDelay = {
					LINKS_Name = "Start Delay (sec, pulse phase)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 5,
					INP_MinAllowed = -60,
					INP_MaxAllowed = 60,
				},
				Red = {
					LINKS_Name = "Dot Red",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.95,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				Green = {
					LINKS_Name = "Dot Green",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.25,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				Blue = {
					LINKS_Name = "Dot Blue",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.1,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				FrameRate = {
					LINKS_Name = "Timeline Frame Rate (match your project)",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 1,
					{ CCS_AddString = "23.976 fps", },
					{ CCS_AddString = "24 fps", },
					{ CCS_AddString = "25 fps", },
					{ CCS_AddString = "29.97 fps", },
					{ CCS_AddString = "30 fps", },
					{ CCS_AddString = "48 fps", },
					{ CCS_AddString = "50 fps", },
					{ CCS_AddString = "59.94 fps", },
					{ CCS_AddString = "60 fps", },
				},
				TimeShift = {
					LINKS_Name = "Time Shift (sec, only if timing looks offset)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 0,
					INP_MinScale = -5,
					INP_MaxScale = 5,
					INP_MinAllowed = -60,
					INP_MaxAllowed = 60,
				},
				FPS = {
					LINKS_Name = "Frame Rate in Use (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 240,
				},
				TimeSec = {
					LINKS_Name = "Clip Time (sec) (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 100000,
				},
				DotP = {
					LINKS_Name = "Marker Scale (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 1,
					INP_MinScale = 0,
					INP_MaxScale = 2,
				},
			},
		},
	},
	ActiveTool = "VOXMapFocus"
}
