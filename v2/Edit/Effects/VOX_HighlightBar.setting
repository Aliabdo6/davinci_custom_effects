{
	Tools = ordered() {
		VOXHighlightBar = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input = InstanceInput { SourceOp = "ImgXf", Source = "Input", },
				EditMode = Input { Value = 0, },
				Pos = InstanceInput { SourceOp = "Anchor", Source = "Center", Name = "Bar Center (drag in viewer)", },
				BarW = Input { Value = 0.2, },
				BarH = Input { Value = 0.035, },
				Dir = Input { Value = 0, },
				Opacity = Input { Value = 1, },
				Red = Input { Value = 0.95, },
				Green = Input { Value = 0.8, },
				Blue = Input { Value = 0.1, },
				StartDelay = Input { Value = 0.2, },
				InDur = Input { Value = 0.35, },
				FrameRate = Input { Value = 1, },
				TimeShift = Input { Value = 0, },
				FPS = Input {
					Value = 24,
					Expression = "max(1,max(0,1-abs(VOXHighlightBar.FrameRate-0))*23.976+max(0,1-abs(VOXHighlightBar.FrameRate-1))*24+max(0,1-abs(VOXHighlightBar.FrameRate-2))*25+max(0,1-abs(VOXHighlightBar.FrameRate-3))*29.97+max(0,1-abs(VOXHighlightBar.FrameRate-4))*30+max(0,1-abs(VOXHighlightBar.FrameRate-5))*48+max(0,1-abs(VOXHighlightBar.FrameRate-6))*50+max(0,1-abs(VOXHighlightBar.FrameRate-7))*59.94+max(0,1-abs(VOXHighlightBar.FrameRate-8))*60)",
				},
				TimeSec = Input { Value = 0, Expression = "time/max(1,VOXHighlightBar.FPS)-VOXHighlightBar.TimeShift", },
				P = Input { Value = 0, Expression = "min(1,max(0,(VOXHighlightBar.TimeSec-VOXHighlightBar.StartDelay)/max(0.05,VOXHighlightBar.InDur)))", },
				Pe = Input { Value = 1, Expression = "((VOXHighlightBar.P)*(VOXHighlightBar.P)*(3-2*(VOXHighlightBar.P)))*(1-VOXHighlightBar.EditMode)+VOXHighlightBar.EditMode", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "GuideMerge", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ImgXf = Transform {
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input { Value = { 0.5, 0.5 }, },
						Size = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				BarBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.95, Expression = "VOXHighlightBar.Red", },
						TopLeftGreen = Input { Value = 0.8, Expression = "VOXHighlightBar.Green", },
						TopLeftBlue = Input { Value = 0.1, Expression = "VOXHighlightBar.Blue", },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 120 } },
				},
				BarMask = RectangleMask {
					Inputs = {
						Solid = Input { Value = 1, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.45 }, Expression = "Point(VOXHighlightBar.Pos.X+(1-2*VOXHighlightBar.Dir)*(VOXHighlightBar.BarW/2)*(VOXHighlightBar.Pe-1),VOXHighlightBar.Pos.Y)", },
						Width = Input { Value = 0.2, Expression = "VOXHighlightBar.BarW*VOXHighlightBar.Pe", },
						Height = Input { Value = 0.035, Expression = "VOXHighlightBar.BarH", },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 120 } },
				},
				BarMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "ImgXf", Source = "Output", },
						Foreground = Input { SourceOp = "BarBG", Source = "Output", },
						EffectMask = Input { SourceOp = "BarMask", Source = "Mask", },
						Blend = Input { Value = 1, Expression = "VOXHighlightBar.Opacity", },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 0 } },
				},
				Anchor = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.003, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.45 }, },
						Width = Input { Value = 0.2, Expression = "VOXHighlightBar.BarW", },
						Height = Input { Value = 0.035, Expression = "VOXHighlightBar.BarH", },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 140 } },
				},
				GuideColor = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 140 } },
				},
				GuideMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "BarMerge", Source = "Output", },
						Foreground = Input { SourceOp = "GuideColor", Source = "Output", },
						EffectMask = Input { SourceOp = "Anchor", Source = "Mask", },
						Blend = Input { Value = 0, Expression = "VOXHighlightBar.EditMode", },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 0 } },
				},
			},
			UserControls = ordered() {
				EditMode = {
					LINKS_Name = "Step 1: Place Bar - ON to position, OFF to play",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
				},
				BarW = {
					LINKS_Name = "Bar Width",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.2,
					INP_MinScale = 0.02,
					INP_MaxScale = 1,
					INP_MinAllowed = 0.001,
					INP_MaxAllowed = 2,
				},
				BarH = {
					LINKS_Name = "Bar Height",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.035,
					INP_MinScale = 0.005,
					INP_MaxScale = 0.3,
					INP_MinAllowed = 0.001,
					INP_MaxAllowed = 2,
				},
				Dir = {
					LINKS_Name = "Wipe Direction",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					INP_Integer = true,
					INP_Default = 0,
					{ CCS_AddString = "Left to right", },
					{ CCS_AddString = "Right to left", },
				},
				Opacity = {
					LINKS_Name = "Opacity (0.4 = highlighter over text)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 1,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				StartDelay = {
					LINKS_Name = "Start Delay (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.2,
					INP_MinScale = 0,
					INP_MaxScale = 5,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 60,
				},
				InDur = {
					LINKS_Name = "Wipe Duration (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.35,
					INP_MinScale = 0.1,
					INP_MaxScale = 2,
					INP_MinAllowed = 0.05,
					INP_MaxAllowed = 10,
				},
				Red = {
					LINKS_Name = "Bar Red",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.95,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				Green = {
					LINKS_Name = "Bar Green",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.8,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				Blue = {
					LINKS_Name = "Bar Blue",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.1,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				FrameRate = {
					LINKS_Name = "Timeline Frame Rate (match your project)",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 1,
					{ CCS_AddString = "23.976 fps", },
					{ CCS_AddString = "24 fps", },
					{ CCS_AddString = "25 fps", },
					{ CCS_AddString = "29.97 fps", },
					{ CCS_AddString = "30 fps", },
					{ CCS_AddString = "48 fps", },
					{ CCS_AddString = "50 fps", },
					{ CCS_AddString = "59.94 fps", },
					{ CCS_AddString = "60 fps", },
				},
				TimeShift = {
					LINKS_Name = "Time Shift (sec, only if timing looks offset)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 0,
					INP_MinScale = -5,
					INP_MaxScale = 5,
					INP_MinAllowed = -60,
					INP_MaxAllowed = 60,
				},
				FPS = {
					LINKS_Name = "Frame Rate in Use (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 240,
				},
				TimeSec = {
					LINKS_Name = "Clip Time (sec) (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 100000,
				},
			},
		},
	},
	ActiveTool = "VOXHighlightBar"
}
