{
	Tools = ordered() {
		VOXCallout = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input = InstanceInput { SourceOp = "ImgXf", Source = "Input", },
				EditMode = Input { Value = 0, },
				Width = InstanceInput { SourceOp = "Shape", Source = "Width", Name = "Callout Width", },
				Height = InstanceInput { SourceOp = "Shape", Source = "Height", Name = "Callout Height", },
				Center = InstanceInput { SourceOp = "Shape", Source = "Center", Name = "Callout Center (drag in viewer)", },
				Thickness = InstanceInput { SourceOp = "Shape", Source = "BorderWidth", Name = "Outline Thickness", },
				Red = Input { Value = 0.95, },
				Green = Input { Value = 0.25, },
				Blue = Input { Value = 0.1, },
				StartDelay = Input { Value = 0.2, },
				InDur = Input { Value = 0.35, },
				Overshoot = Input { Value = 0.15, },
				Pulse = Input { Value = 0, },
				FrameRate = Input { Value = 1, },
				TimeShift = Input { Value = 0, },
				FPS = Input {
					Value = 24,
					Expression = "max(1,max(0,1-abs(VOXCallout.FrameRate-0))*23.976+max(0,1-abs(VOXCallout.FrameRate-1))*24+max(0,1-abs(VOXCallout.FrameRate-2))*25+max(0,1-abs(VOXCallout.FrameRate-3))*29.97+max(0,1-abs(VOXCallout.FrameRate-4))*30+max(0,1-abs(VOXCallout.FrameRate-5))*48+max(0,1-abs(VOXCallout.FrameRate-6))*50+max(0,1-abs(VOXCallout.FrameRate-7))*59.94+max(0,1-abs(VOXCallout.FrameRate-8))*60)",
				},
				TimeSec = Input { Value = 0, Expression = "time/max(1,VOXCallout.FPS)-VOXCallout.TimeShift", },
				P = Input { Value = 0, Expression = "min(1,max(0,(VOXCallout.TimeSec-VOXCallout.StartDelay)/max(0.05,VOXCallout.InDur)))", },
				S = Input { Value = 0, Expression = "((VOXCallout.P)*(VOXCallout.P)*(3-2*(VOXCallout.P)))+VOXCallout.Overshoot*sin(3.14159265*(VOXCallout.P))*(1-(VOXCallout.P))", },
				SF = Input { Value = 1, Expression = "(VOXCallout.S*(1-VOXCallout.EditMode)+VOXCallout.EditMode)*(1+VOXCallout.Pulse*0.03*sin(6.28318*(VOXCallout.TimeSec-VOXCallout.StartDelay))*(1-VOXCallout.EditMode))", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Out", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ImgXf = Transform {
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input { Value = { 0.5, 0.5 }, },
						Size = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				Shape = EllipseMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.008, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0.3, },
						Height = Input { Value = 0.3, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 120 } },
				},
				ColorBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.95, Expression = "VOXCallout.Red", },
						TopLeftGreen = Input { Value = 0.25, Expression = "VOXCallout.Green", },
						TopLeftBlue = Input { Value = 0.1, Expression = "VOXCallout.Blue", },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 120 } },
				},
				EmptyBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 200 } },
				},
				Layer = Merge {
					Inputs = {
						Background = Input { SourceOp = "EmptyBG", Source = "Output", },
						Foreground = Input { SourceOp = "ColorBG", Source = "Output", },
						EffectMask = Input { SourceOp = "Shape", Source = "Mask", },
						Blend = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 160 } },
				},
				LayerXf = Transform {
					Inputs = {
						Input = Input { SourceOp = "Layer", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXCallout.Center.X,VOXCallout.Center.Y)", },
						Size = Input { Value = 1, Expression = "VOXCallout.SF", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 120 } },
				},
				Out = Merge {
					Inputs = {
						Background = Input { SourceOp = "ImgXf", Source = "Output", },
						Foreground = Input { SourceOp = "LayerXf", Source = "Output", },
						Blend = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 0 } },
				},
			},
			UserControls = ordered() {
				EditMode = {
					LINKS_Name = "Step 1: Place Callout - ON to position at full size",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
				},
				StartDelay = {
					LINKS_Name = "Start Delay (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.2,
					INP_MinScale = 0,
					INP_MaxScale = 5,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 60,
				},
				InDur = {
					LINKS_Name = "Draw-On Duration (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.35,
					INP_MinScale = 0.1,
					INP_MaxScale = 2,
					INP_MinAllowed = 0.05,
					INP_MaxAllowed = 10,
				},
				Overshoot = {
					LINKS_Name = "Overshoot (0 = no snap)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.15,
					INP_MinScale = 0,
					INP_MaxScale = 0.6,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 2,
				},
				Pulse = {
					LINKS_Name = "Pulse After Draw-On (0 = off)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 2,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 5,
				},
				Red = {
					LINKS_Name = "Outline Red",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.95,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				Green = {
					LINKS_Name = "Outline Green",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.25,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				Blue = {
					LINKS_Name = "Outline Blue",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.1,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				FrameRate = {
					LINKS_Name = "Timeline Frame Rate (match your project)",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 1,
					{ CCS_AddString = "23.976 fps", },
					{ CCS_AddString = "24 fps", },
					{ CCS_AddString = "25 fps", },
					{ CCS_AddString = "29.97 fps", },
					{ CCS_AddString = "30 fps", },
					{ CCS_AddString = "48 fps", },
					{ CCS_AddString = "50 fps", },
					{ CCS_AddString = "59.94 fps", },
					{ CCS_AddString = "60 fps", },
				},
				TimeShift = {
					LINKS_Name = "Time Shift (sec, only if timing looks offset)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 0,
					INP_MinScale = -5,
					INP_MaxScale = 5,
					INP_MinAllowed = -60,
					INP_MaxAllowed = 60,
				},
				FPS = {
					LINKS_Name = "Frame Rate in Use (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 240,
				},
				TimeSec = {
					LINKS_Name = "Clip Time (sec) (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 100000,
				},
				SF = {
					LINKS_Name = "Current Size Factor (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 1,
					INP_MinScale = 0,
					INP_MaxScale = 2,
				},
			},
		},
	},
	ActiveTool = "VOXCallout"
}
