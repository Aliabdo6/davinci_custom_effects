{
	Tools = ordered() {
		VOXStatCard = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input = InstanceInput { SourceOp = "ImgXf", Source = "Input", },
				EditMode = Input { Value = 0, },
				Pos = InstanceInput { SourceOp = "Anchor", Source = "Center", Name = "Card Position (drag box in viewer)", },
				Value = InstanceInput { SourceOp = "ValueTextNode", Source = "StyledText", Name = "Big Value Text", },
				Label = InstanceInput { SourceOp = "LabelTextNode", Source = "StyledText", Name = "Small Label Text", },
				ValueSize = InstanceInput { SourceOp = "ValueTextNode", Source = "Size", Name = "Big Text Size", },
				LabelSize = InstanceInput { SourceOp = "LabelTextNode", Source = "Size", Name = "Label Text Size", },
				Red = Input { Value = 0.95, },
				Green = Input { Value = 0.25, },
				Blue = Input { Value = 0.1, },
				StartDelay = Input { Value = 0.3, },
				InDur = Input { Value = 0.4, },
				Stagger = Input { Value = 0.12, },
				FrameRate = Input { Value = 1, },
				TimeShift = Input { Value = 0, },
				FPS = Input {
					Value = 24,
					Expression = "max(1,max(0,1-abs(VOXStatCard.FrameRate-0))*23.976+max(0,1-abs(VOXStatCard.FrameRate-1))*24+max(0,1-abs(VOXStatCard.FrameRate-2))*25+max(0,1-abs(VOXStatCard.FrameRate-3))*29.97+max(0,1-abs(VOXStatCard.FrameRate-4))*30+max(0,1-abs(VOXStatCard.FrameRate-5))*48+max(0,1-abs(VOXStatCard.FrameRate-6))*50+max(0,1-abs(VOXStatCard.FrameRate-7))*59.94+max(0,1-abs(VOXStatCard.FrameRate-8))*60)",
				},
				TimeSec = Input { Value = 0, Expression = "time/max(1,VOXStatCard.FPS)-VOXStatCard.TimeShift", },
				P1 = Input { Value = 0, Expression = "min(1,max(0,(VOXStatCard.TimeSec-VOXStatCard.StartDelay)/max(0.05,VOXStatCard.InDur)))", },
				P2 = Input { Value = 0, Expression = "min(1,max(0,(VOXStatCard.TimeSec-VOXStatCard.StartDelay-VOXStatCard.Stagger)/max(0.05,VOXStatCard.InDur)))", },
				P3 = Input { Value = 0, Expression = "min(1,max(0,(VOXStatCard.TimeSec-VOXStatCard.StartDelay-2*VOXStatCard.Stagger)/max(0.05,VOXStatCard.InDur)))", },
				A1 = Input { Value = 0, Expression = "((VOXStatCard.P1)*(VOXStatCard.P1)*(3-2*(VOXStatCard.P1)))*(1-VOXStatCard.EditMode)+VOXStatCard.EditMode", },
				A2 = Input { Value = 0, Expression = "((VOXStatCard.P2)*(VOXStatCard.P2)*(3-2*(VOXStatCard.P2)))*(1-VOXStatCard.EditMode)+VOXStatCard.EditMode", },
				A3 = Input { Value = 0, Expression = "((VOXStatCard.P3)*(VOXStatCard.P3)*(3-2*(VOXStatCard.P3)))*(1-VOXStatCard.EditMode)+VOXStatCard.EditMode", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "AnchorMerge", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ImgXf = Transform {
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input { Value = { 0.5, 0.5 }, },
						Size = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				ValueTextNode = TextPlus {
					Inputs = {
						StyledText = Input { Value = "1.2M", },
						Size = Input { Value = 0.14, },
						Center = Input { Value = { 0.5, 0.47 }, Expression = "Point(VOXStatCard.Pos.X,VOXStatCard.Pos.Y+0.02-0.03*(1-VOXStatCard.A2))", },
						Red = Input { Value = 1, },
						Green = Input { Value = 1, },
						Blue = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 90 } },
				},
				LabelTextNode = TextPlus {
					Inputs = {
						StyledText = Input { Value = "people affected", },
						Size = Input { Value = 0.035, },
						Center = Input { Value = { 0.5, 0.33 }, Expression = "Point(VOXStatCard.Pos.X,VOXStatCard.Pos.Y-0.12-0.02*(1-VOXStatCard.A3))", },
						Red = Input { Value = 0.85, },
						Green = Input { Value = 0.85, },
						Blue = Input { Value = 0.85, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 170 } },
				},
				BarBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.95, Expression = "VOXStatCard.Red", },
						TopLeftGreen = Input { Value = 0.25, Expression = "VOXStatCard.Green", },
						TopLeftBlue = Input { Value = 0.1, Expression = "VOXStatCard.Blue", },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 250 } },
				},
				BarMask = RectangleMask {
					Inputs = {
						Solid = Input { Value = 1, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.6 }, Expression = "Point(VOXStatCard.Pos.X-0.07+0.07*VOXStatCard.A1,VOXStatCard.Pos.Y+0.13)", },
						Width = Input { Value = 0.14, Expression = "0.14*VOXStatCard.A1", },
						Height = Input { Value = 0.01, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 250 } },
				},
				Anchor = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.003, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.45 }, },
						Width = Input { Value = 0.36, },
						Height = Input { Value = 0.36, },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 330 } },
				},
				GuideColor = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 330 } },
				},
				BarMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "ImgXf", Source = "Output", },
						Foreground = Input { SourceOp = "BarBG", Source = "Output", },
						EffectMask = Input { SourceOp = "BarMask", Source = "Mask", },
						Blend = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 0 } },
				},
				ValueMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "BarMerge", Source = "Output", },
						Foreground = Input { SourceOp = "ValueTextNode", Source = "Output", },
						Blend = Input { Value = 0, Expression = "VOXStatCard.A2", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 0 } },
				},
				LabelMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "ValueMerge", Source = "Output", },
						Foreground = Input { SourceOp = "LabelTextNode", Source = "Output", },
						Blend = Input { Value = 0, Expression = "VOXStatCard.A3", },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 0 } },
				},
				AnchorMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "LabelMerge", Source = "Output", },
						Foreground = Input { SourceOp = "GuideColor", Source = "Output", },
						EffectMask = Input { SourceOp = "Anchor", Source = "Mask", },
						Blend = Input { Value = 0, Expression = "VOXStatCard.EditMode", },
					},
					ViewInfo = OperatorInfo { Pos = { 605, 0 } },
				},
			},
			UserControls = ordered() {
				EditMode = {
					LINKS_Name = "Step 1: Place Card - ON to position, OFF to play",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
				},
				StartDelay = {
					LINKS_Name = "Start Delay (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.3,
					INP_MinScale = 0,
					INP_MaxScale = 5,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 60,
				},
				InDur = {
					LINKS_Name = "Build Duration (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.4,
					INP_MinScale = 0.1,
					INP_MaxScale = 2,
					INP_MinAllowed = 0.05,
					INP_MaxAllowed = 10,
				},
				Stagger = {
					LINKS_Name = "Stagger Between Elements (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.12,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 5,
				},
				Red = {
					LINKS_Name = "Accent Red",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.95,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				Green = {
					LINKS_Name = "Accent Green",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.25,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				Blue = {
					LINKS_Name = "Accent Blue",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Color",
					INP_Default = 0.1,
					INP_MinScale = 0,
					INP_MaxScale = 1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				FrameRate = {
					LINKS_Name = "Timeline Frame Rate (match your project)",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 1,
					{ CCS_AddString = "23.976 fps", },
					{ CCS_AddString = "24 fps", },
					{ CCS_AddString = "25 fps", },
					{ CCS_AddString = "29.97 fps", },
					{ CCS_AddString = "30 fps", },
					{ CCS_AddString = "48 fps", },
					{ CCS_AddString = "50 fps", },
					{ CCS_AddString = "59.94 fps", },
					{ CCS_AddString = "60 fps", },
				},
				TimeShift = {
					LINKS_Name = "Time Shift (sec, only if timing looks offset)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 0,
					INP_MinScale = -5,
					INP_MaxScale = 5,
					INP_MinAllowed = -60,
					INP_MaxAllowed = 60,
				},
				FPS = {
					LINKS_Name = "Frame Rate in Use (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 240,
				},
				TimeSec = {
					LINKS_Name = "Clip Time (sec) (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 100000,
				},
			},
		},
	},
	ActiveTool = "VOXStatCard"
}
