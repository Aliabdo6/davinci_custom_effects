{
	Tools = ordered() {
		VOXArchivalPush = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input = InstanceInput { SourceOp = "Xf", Source = "Input", },
				StartZoom = Input { Value = 1, },
				EndZoom = Input { Value = 1.15, },
				StartDelay = Input { Value = 0, },
				Duration = Input { Value = 8, },
				DriftX = Input { Value = 0, },
				DriftY = Input { Value = 0, },
				Bob = Input { Value = 0, },
				EaseStyle = Input { Value = 0, },
				FrameRate = Input { Value = 1, },
				TimeShift = Input { Value = 0, },
				MaxZoom = Input { Value = 4, },
				FPS = Input {
					Value = 24,
					Expression = "max(1,max(0,1-abs(VOXArchivalPush.FrameRate-0))*23.976+max(0,1-abs(VOXArchivalPush.FrameRate-1))*24+max(0,1-abs(VOXArchivalPush.FrameRate-2))*25+max(0,1-abs(VOXArchivalPush.FrameRate-3))*29.97+max(0,1-abs(VOXArchivalPush.FrameRate-4))*30+max(0,1-abs(VOXArchivalPush.FrameRate-5))*48+max(0,1-abs(VOXArchivalPush.FrameRate-6))*50+max(0,1-abs(VOXArchivalPush.FrameRate-7))*59.94+max(0,1-abs(VOXArchivalPush.FrameRate-8))*60)",
				},
				TimeSec = Input { Value = 0, Expression = "time/max(1,VOXArchivalPush.FPS)-VOXArchivalPush.TimeShift", },
				P = Input { Value = 0, Expression = "min(1,max(0,(VOXArchivalPush.TimeSec-VOXArchivalPush.StartDelay)/max(0.1,VOXArchivalPush.Duration)))", },
				E = Input { Value = 0, Expression = "max(0,1-abs(VOXArchivalPush.EaseStyle-0))*(VOXArchivalPush.P)+max(0,1-abs(VOXArchivalPush.EaseStyle-1))*(0.5*(VOXArchivalPush.P)+0.5*((VOXArchivalPush.P)*(VOXArchivalPush.P)*(3-2*(VOXArchivalPush.P))))+max(0,1-abs(VOXArchivalPush.EaseStyle-2))*((VOXArchivalPush.P)*(VOXArchivalPush.P)*(3-2*(VOXArchivalPush.P)))+max(0,1-abs(VOXArchivalPush.EaseStyle-3))*((VOXArchivalPush.P)*(VOXArchivalPush.P)*(VOXArchivalPush.P)*((VOXArchivalPush.P)*(6*(VOXArchivalPush.P)-15)+10))+max(0,1-abs(VOXArchivalPush.EaseStyle-4))*(((VOXArchivalPush.P)*(VOXArchivalPush.P)*(3-2*(VOXArchivalPush.P)))*((VOXArchivalPush.P)*(VOXArchivalPush.P)*(3-2*(VOXArchivalPush.P)))*(3-2*((VOXArchivalPush.P)*(VOXArchivalPush.P)*(3-2*(VOXArchivalPush.P)))))", },
				Z = Input { Value = 1, Expression = "min(VOXArchivalPush.MaxZoom,max(0.05,VOXArchivalPush.StartZoom*pow(max(0.05,VOXArchivalPush.EndZoom)/max(0.05,VOXArchivalPush.StartZoom),VOXArchivalPush.E)))", },
				PX = Input { Value = 0.5, Expression = "0.5+VOXArchivalPush.DriftX*VOXArchivalPush.E+VOXArchivalPush.Bob*sin(VOXArchivalPush.TimeSec*7.5)", },
				PY = Input { Value = 0.5, Expression = "0.5+VOXArchivalPush.DriftY*VOXArchivalPush.E+VOXArchivalPush.Bob*0.7*sin(VOXArchivalPush.TimeSec*5.13+1.7)", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Xf", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Xf = Transform {
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXArchivalPush.PX,VOXArchivalPush.PY)", },
						Size = Input { Value = 1, Expression = "VOXArchivalPush.Z", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
			},
			UserControls = ordered() {
				EndZoom = {
					LINKS_Name = "End Zoom (1.15 = very slow push-in)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 1.15,
					INP_MinScale = 1,
					INP_MaxScale = 1.6,
					INP_MinAllowed = 0.1,
					INP_MaxAllowed = 20,
				},
				StartZoom = {
					LINKS_Name = "Start Zoom",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 1,
					INP_MinScale = 1,
					INP_MaxScale = 1.6,
					INP_MinAllowed = 0.1,
					INP_MaxAllowed = 20,
				},
				Duration = {
					LINKS_Name = "Move Duration (sec, whole shot)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 8,
					INP_MinScale = 1,
					INP_MaxScale = 20,
					INP_MinAllowed = 0.2,
					INP_MaxAllowed = 600,
				},
				StartDelay = {
					LINKS_Name = "Start Delay (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 5,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 60,
				},
				DriftX = {
					LINKS_Name = "Drift X (view moves right)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Motion",
					INP_Default = 0,
					INP_MinScale = -0.1,
					INP_MaxScale = 0.1,
					INP_MinAllowed = -0.5,
					INP_MaxAllowed = 0.5,
				},
				DriftY = {
					LINKS_Name = "Drift Y (view moves up)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Motion",
					INP_Default = 0,
					INP_MinScale = -0.1,
					INP_MaxScale = 0.1,
					INP_MinAllowed = -0.5,
					INP_MaxAllowed = 0.5,
				},
				Bob = {
					LINKS_Name = "Handheld Bob (0 = perfectly stable)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Motion",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 0.004,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 0.02,
				},
				EaseStyle = {
					LINKS_Name = "Motion Curve",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 0,
					{ CCS_AddString = "Constant speed (classic archival)", },
					{ CCS_AddString = "Gentle", },
					{ CCS_AddString = "Smooth", },
					{ CCS_AddString = "Silky", },
					{ CCS_AddString = "Cinematic (slow start/end)", },
				},
				FrameRate = {
					LINKS_Name = "Timeline Frame Rate (match your project)",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 1,
					{ CCS_AddString = "23.976 fps", },
					{ CCS_AddString = "24 fps", },
					{ CCS_AddString = "25 fps", },
					{ CCS_AddString = "29.97 fps", },
					{ CCS_AddString = "30 fps", },
					{ CCS_AddString = "48 fps", },
					{ CCS_AddString = "50 fps", },
					{ CCS_AddString = "59.94 fps", },
					{ CCS_AddString = "60 fps", },
				},
				TimeShift = {
					LINKS_Name = "Time Shift (sec, only if timing looks offset)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 0,
					INP_MinScale = -5,
					INP_MaxScale = 5,
					INP_MinAllowed = -60,
					INP_MaxAllowed = 60,
				},
				MaxZoom = {
					LINKS_Name = "Max Zoom (safety limit)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Advanced",
					INP_Default = 4,
					INP_MinScale = 1,
					INP_MaxScale = 20,
					INP_MinAllowed = 1,
				},
				FPS = {
					LINKS_Name = "Frame Rate in Use (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 240,
				},
				TimeSec = {
					LINKS_Name = "Clip Time (sec) (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 100000,
				},
				Z = {
					LINKS_Name = "Current Zoom (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 1,
					INP_MinScale = 0.5,
					INP_MaxScale = 20,
				},
			},
		},
	},
	ActiveTool = "VOXArchivalPush"
}
