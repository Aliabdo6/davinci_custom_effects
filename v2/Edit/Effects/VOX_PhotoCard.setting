{
	Tools = ordered() {
		VOXPhotoCard = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input = InstanceInput { SourceOp = "ImgXf", Source = "Input", },
				EditMode = Input { Value = 0, },
				Pos = InstanceInput { SourceOp = "Anchor", Source = "Center", Name = "Card Center (drag in viewer)", },
				CardW = Input { Value = 0.6, },
				CardH = Input { Value = 0.5, },
				Inset = Input { Value = 0.035, },
				Rotation = Input { Value = -2, },
				SlideDist = Input { Value = 0.25, },
				Dir = Input { Value = 0, },
				StartDelay = Input { Value = 0, },
				InDur = Input { Value = 0.5, },
				Overshoot = Input { Value = 0.12, },
				ShadowX = Input { Value = 0.015, },
				ShadowY = Input { Value = -0.02, },
				ShadowOpacity = Input { Value = 0.4, },
				ShadowSoft = Input { Value = 10, },
				FrameRate = Input { Value = 1, },
				TimeShift = Input { Value = 0, },
				FPS = Input {
					Value = 24,
					Expression = "max(1,max(0,1-abs(VOXPhotoCard.FrameRate-0))*23.976+max(0,1-abs(VOXPhotoCard.FrameRate-1))*24+max(0,1-abs(VOXPhotoCard.FrameRate-2))*25+max(0,1-abs(VOXPhotoCard.FrameRate-3))*29.97+max(0,1-abs(VOXPhotoCard.FrameRate-4))*30+max(0,1-abs(VOXPhotoCard.FrameRate-5))*48+max(0,1-abs(VOXPhotoCard.FrameRate-6))*50+max(0,1-abs(VOXPhotoCard.FrameRate-7))*59.94+max(0,1-abs(VOXPhotoCard.FrameRate-8))*60)",
				},
				TimeSec = Input { Value = 0, Expression = "time/max(1,VOXPhotoCard.FPS)-VOXPhotoCard.TimeShift", },
				P = Input { Value = 0, Expression = "min(1,max(0,(VOXPhotoCard.TimeSec-VOXPhotoCard.StartDelay)/max(0.05,VOXPhotoCard.InDur)))", },
				S = Input { Value = 0, Expression = "((VOXPhotoCard.P)*(VOXPhotoCard.P)*(3-2*(VOXPhotoCard.P)))+VOXPhotoCard.Overshoot*sin(3.14159265*(VOXPhotoCard.P))*(1-(VOXPhotoCard.P))", },
				Ef = Input { Value = 1, Expression = "VOXPhotoCard.S*(1-VOXPhotoCard.EditMode)+VOXPhotoCard.EditMode", },
				InW = Input { Value = 0.5, Expression = "max(0.01,VOXPhotoCard.CardW-2*VOXPhotoCard.Inset)", },
				InH = Input { Value = 0.4, Expression = "max(0.01,VOXPhotoCard.CardH-2*VOXPhotoCard.Inset)", },
				OX = Input { Value = 0, Expression = "VOXPhotoCard.SlideDist*(1-VOXPhotoCard.Ef)*(max(0,1-abs(VOXPhotoCard.Dir-1))-max(0,1-abs(VOXPhotoCard.Dir-0)))", },
				OY = Input { Value = 0, Expression = "VOXPhotoCard.SlideDist*(1-VOXPhotoCard.Ef)*(max(0,1-abs(VOXPhotoCard.Dir-3))-max(0,1-abs(VOXPhotoCard.Dir-2)))", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "GuideMerge", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ImgXf = Transform {
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input { Value = { 0.5, 0.5 }, },
						Size = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 0 } },
				},
				EmptyBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 120 } },
				},
				ShadowBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 55, 200 } },
				},
				ShadowMask = RectangleMask {
					Inputs = {
						Solid = Input { Value = 1, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXPhotoCard.Pos.X+VOXPhotoCard.ShadowX,VOXPhotoCard.Pos.Y+VOXPhotoCard.ShadowY)", },
						Width = Input { Value = 0.6, Expression = "VOXPhotoCard.CardW", },
						Height = Input { Value = 0.5, Expression = "VOXPhotoCard.CardH", },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 200 } },
				},
				ShadowLayer = Merge {
					Inputs = {
						Background = Input { SourceOp = "EmptyBG", Source = "Output", },
						Foreground = Input { SourceOp = "ShadowBG", Source = "Output", },
						EffectMask = Input { SourceOp = "ShadowMask", Source = "Mask", },
						Blend = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 275, 160 } },
				},
				ShadowBlur = Blur {
					Inputs = {
						Input = Input { SourceOp = "ShadowLayer", Source = "Output", },
						Size = Input { Value = 10, Expression = "VOXPhotoCard.ShadowSoft", },
					},
					ViewInfo = OperatorInfo { Pos = { 385, 160 } },
				},
				ShadowMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "ImgXf", Source = "Output", },
						Foreground = Input { SourceOp = "ShadowBlur", Source = "Output", },
						Blend = Input { Value = 0.4, Expression = "VOXPhotoCard.ShadowOpacity", },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 0 } },
				},
				CardBG = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 0.97, },
						TopLeftGreen = Input { Value = 0.96, },
						TopLeftBlue = Input { Value = 0.93, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 120 } },
				},
				CardMask = RectangleMask {
					Inputs = {
						Solid = Input { Value = 1, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXPhotoCard.Pos.X,VOXPhotoCard.Pos.Y)", },
						Width = Input { Value = 0.6, Expression = "VOXPhotoCard.CardW", },
						Height = Input { Value = 0.5, Expression = "VOXPhotoCard.CardH", },
					},
					ViewInfo = OperatorInfo { Pos = { 495, 200 } },
				},
				CardMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "ShadowMerge", Source = "Output", },
						Foreground = Input { SourceOp = "CardBG", Source = "Output", },
						EffectMask = Input { SourceOp = "CardMask", Source = "Mask", },
						Blend = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 605, 0 } },
				},
				PhotoXf = Transform {
					Inputs = {
						Input = Input { SourceOp = "ImgXf", Source = "Output", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXPhotoCard.Pos.X,VOXPhotoCard.Pos.Y)", },
						Pivot = Input { Value = { 0.5, 0.5 }, },
						Size = Input { Value = 1, Expression = "max(VOXPhotoCard.InW,VOXPhotoCard.InH)", },
					},
					ViewInfo = OperatorInfo { Pos = { 605, 120 } },
				},
				PhotoMask = RectangleMask {
					Inputs = {
						Solid = Input { Value = 1, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXPhotoCard.Pos.X,VOXPhotoCard.Pos.Y)", },
						Width = Input { Value = 0.5, Expression = "VOXPhotoCard.InW", },
						Height = Input { Value = 0.4, Expression = "VOXPhotoCard.InH", },
					},
					ViewInfo = OperatorInfo { Pos = { 605, 200 } },
				},
				PhotoMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "CardMerge", Source = "Output", },
						Foreground = Input { SourceOp = "PhotoXf", Source = "Output", },
						EffectMask = Input { SourceOp = "PhotoMask", Source = "Mask", },
						Blend = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 715, 0 } },
				},
				MasterXf = Transform {
					Inputs = {
						Input = Input { SourceOp = "PhotoMerge", Source = "Output", },
						Pivot = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXPhotoCard.Pos.X,VOXPhotoCard.Pos.Y)", },
						Center = Input { Value = { 0.5, 0.5 }, Expression = "Point(VOXPhotoCard.Pos.X+VOXPhotoCard.OX,VOXPhotoCard.Pos.Y+VOXPhotoCard.OY)", },
						Angle = Input { Value = -2, Expression = "VOXPhotoCard.Rotation", },
					},
					ViewInfo = OperatorInfo { Pos = { 825, 0 } },
				},
				Anchor = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.003, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0.6, Expression = "VOXPhotoCard.CardW", },
						Height = Input { Value = 0.5, Expression = "VOXPhotoCard.CardH", },
					},
					ViewInfo = OperatorInfo { Pos = { 825, 140 } },
				},
				GuideColor = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 935, 140 } },
				},
				GuideMerge = Merge {
					Inputs = {
						Background = Input { SourceOp = "MasterXf", Source = "Output", },
						Foreground = Input { SourceOp = "GuideColor", Source = "Output", },
						EffectMask = Input { SourceOp = "Anchor", Source = "Mask", },
						Blend = Input { Value = 0, Expression = "VOXPhotoCard.EditMode", },
					},
					ViewInfo = OperatorInfo { Pos = { 935, 0 } },
				},
			},
			UserControls = ordered() {
				EditMode = {
					LINKS_Name = "Step 1: Place Card - ON to position, OFF to play",
					LINKID_DataType = "Number",
					INPID_InputControl = "CheckboxControl",
					INP_Integer = true,
					INP_Default = 0,
				},
				CardW = {
					LINKS_Name = "Card Width",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.6,
					INP_MinScale = 0.1,
					INP_MaxScale = 1,
					INP_MinAllowed = 0.05,
					INP_MaxAllowed = 2,
				},
				CardH = {
					LINKS_Name = "Card Height",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.5,
					INP_MinScale = 0.1,
					INP_MaxScale = 1,
					INP_MinAllowed = 0.05,
					INP_MaxAllowed = 2,
				},
				Inset = {
					LINKS_Name = "Paper Border (inset)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.035,
					INP_MinScale = 0.005,
					INP_MaxScale = 0.1,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 0.5,
				},
				Rotation = {
					LINKS_Name = "Card Rotation (deg)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = -2,
					INP_MinScale = -10,
					INP_MaxScale = 10,
					INP_MinAllowed = -90,
					INP_MaxAllowed = 90,
				},
				SlideDist = {
					LINKS_Name = "Entrance Distance",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.25,
					INP_MinScale = 0,
					INP_MaxScale = 0.6,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 2,
				},
				Dir = {
					LINKS_Name = "Entrance From",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					INP_Integer = true,
					INP_Default = 0,
					{ CCS_AddString = "Left", },
					{ CCS_AddString = "Right", },
					{ CCS_AddString = "Bottom", },
					{ CCS_AddString = "Top", },
				},
				StartDelay = {
					LINKS_Name = "Start Delay (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 5,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 60,
				},
				InDur = {
					LINKS_Name = "Entrance Duration (sec)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.5,
					INP_MinScale = 0.1,
					INP_MaxScale = 2,
					INP_MinAllowed = 0.05,
					INP_MaxAllowed = 10,
				},
				Overshoot = {
					LINKS_Name = "Overshoot (0 = no snap)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					INP_Default = 0.12,
					INP_MinScale = 0,
					INP_MaxScale = 0.5,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 2,
				},
				ShadowX = {
					LINKS_Name = "Shadow Offset X",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Shadow",
					INP_Default = 0.015,
					INP_MinScale = -0.08,
					INP_MaxScale = 0.08,
					INP_MinAllowed = -0.5,
					INP_MaxAllowed = 0.5,
				},
				ShadowY = {
					LINKS_Name = "Shadow Offset Y",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Shadow",
					INP_Default = -0.02,
					INP_MinScale = -0.08,
					INP_MaxScale = 0.08,
					INP_MinAllowed = -0.5,
					INP_MaxAllowed = 0.5,
				},
				ShadowOpacity = {
					LINKS_Name = "Shadow Darkness",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Shadow",
					INP_Default = 0.4,
					INP_MinScale = 0,
					INP_MaxScale = 0.8,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 1,
				},
				ShadowSoft = {
					LINKS_Name = "Shadow Softness (px)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Shadow",
					INP_Default = 10,
					INP_MinScale = 0,
					INP_MaxScale = 60,
					INP_MinAllowed = 0,
					INP_MaxAllowed = 200,
				},
				FrameRate = {
					LINKS_Name = "Timeline Frame Rate (match your project)",
					LINKID_DataType = "Number",
					INPID_InputControl = "ComboControl",
					ICS_ControlPage = "Timing",
					INP_Integer = true,
					INP_Default = 1,
					{ CCS_AddString = "23.976 fps", },
					{ CCS_AddString = "24 fps", },
					{ CCS_AddString = "25 fps", },
					{ CCS_AddString = "29.97 fps", },
					{ CCS_AddString = "30 fps", },
					{ CCS_AddString = "48 fps", },
					{ CCS_AddString = "50 fps", },
					{ CCS_AddString = "59.94 fps", },
					{ CCS_AddString = "60 fps", },
				},
				TimeShift = {
					LINKS_Name = "Time Shift (sec, only if timing looks offset)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Timing",
					INP_Default = 0,
					INP_MinScale = -5,
					INP_MaxScale = 5,
					INP_MinAllowed = -60,
					INP_MaxAllowed = 60,
				},
				FPS = {
					LINKS_Name = "Frame Rate in Use (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 240,
				},
				TimeSec = {
					LINKS_Name = "Clip Time (sec) (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = 0,
					INP_MaxScale = 100000,
				},
				OX = {
					LINKS_Name = "Slide X (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = -1,
					INP_MaxScale = 1,
				},
				OY = {
					LINKS_Name = "Slide Y (read only)",
					LINKID_DataType = "Number",
					INPID_InputControl = "SliderControl",
					ICS_ControlPage = "Debug",
					INP_Default = 0,
					INP_MinScale = -1,
					INP_MaxScale = 1,
				},
			},
		},
	},
	ActiveTool = "VOXPhotoCard"
}
