{
	Tools = ordered() {
		CineFocusMulti = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input = InstanceInput { SourceOp = "ZoomXf", Source = "Input", },
				EditMode = Input { Value = 0, },
				PreviewTarget = Input { Value = 1, },
				NumTargets = Input { Value = 2, },
				StartDelay = Input { Value = 0.5, },
				MoveDur = Input { Value = 1.2, },
				PanLead = Input { Value = 0.25, },
				EaseStyle = Input { Value = 3, },
				AfterLast = Input { Value = 1, },
				FitMode = Input { Value = 0, },
				Padding = Input { Value = 0, },
				MaxZoom = Input { Value = 8, },
				MotionBlur = Input { Value = 0, },
				BlurSamples = Input { Value = 8, },
				SoftBlur = Input { Value = 0, },
				FrameRate = Input { Value = 1, },
				TimeShift = Input { Value = 0, },
				Hold1 = Input { Value = 1.5, },
				Center1 = InstanceInput { SourceOp = "GuideRect1", Source = "Center", Name = "Target 1 Center (drag in viewer)", },
				Width1 = InstanceInput { SourceOp = "GuideRect1", Source = "Width", Name = "Target 1 Width", },
				Height1 = InstanceInput { SourceOp = "GuideRect1", Source = "Height", Name = "Target 1 Height", },
				Hold2 = Input { Value = 1.5, },
				Center2 = InstanceInput { SourceOp = "GuideRect2", Source = "Center", Name = "Target 2 Center (drag in viewer)", },
				Width2 = InstanceInput { SourceOp = "GuideRect2", Source = "Width", Name = "Target 2 Width", },
				Height2 = InstanceInput { SourceOp = "GuideRect2", Source = "Height", Name = "Target 2 Height", },
				Hold3 = Input { Value = 1.5, },
				Center3 = InstanceInput { SourceOp = "GuideRect3", Source = "Center", Name = "Target 3 Center (drag in viewer)", },
				Width3 = InstanceInput { SourceOp = "GuideRect3", Source = "Width", Name = "Target 3 Width", },
				Height3 = InstanceInput { SourceOp = "GuideRect3", Source = "Height", Name = "Target 3 Height", },
				Hold4 = Input { Value = 1.5, },
				Center4 = InstanceInput { SourceOp = "GuideRect4", Source = "Center", Name = "Target 4 Center (drag in viewer)", },
				Width4 = InstanceInput { SourceOp = "GuideRect4", Source = "Width", Name = "Target 4 Width", },
				Height4 = InstanceInput { SourceOp = "GuideRect4", Source = "Height", Name = "Target 4 Height", },
				FPS = Input {
					Value = 24,
					Expression = "max(1,max(0,1-abs(CineFocusMulti.FrameRate-0))*23.976+max(0,1-abs(CineFocusMulti.FrameRate-1))*24+max(0,1-abs(CineFocusMulti.FrameRate-2))*25+max(0,1-abs(CineFocusMulti.FrameRate-3))*29.97+max(0,1-abs(CineFocusMulti.FrameRate-4))*30+max(0,1-abs(CineFocusMulti.FrameRate-5))*48+max(0,1-abs(CineFocusMulti.FrameRate-6))*50+max(0,1-abs(CineFocusMulti.FrameRate-7))*59.94+max(0,1-abs(CineFocusMulti.FrameRate-8))*60)",
				},
				TimeSec = Input { Value = 0, Expression = "time/max(1,CineFocusMulti.FPS)-CineFocusMulti.TimeShift", },
				Z1 = Input { Value = 2, Expression = "min(CineFocusMulti.MaxZoom,max(1,1/((max(max(0.01,abs(CineFocusMulti.Width1)),max(0.01,abs(CineFocusMulti.Height1)))*(1-CineFocusMulti.FitMode)+min(max(0.01,abs(CineFocusMulti.Width1)),max(0.01,abs(CineFocusMulti.Height1)))*CineFocusMulti.FitMode)*(1+CineFocusMulti.Padding))))", },
				Z2 = Input { Value = 2, Expression = "min(CineFocusMulti.MaxZoom,max(1,1/((max(max(0.01,abs(CineFocusMulti.Width2)),max(0.01,abs(CineFocusMulti.Height2)))*(1-CineFocusMulti.FitMode)+min(max(0.01,abs(CineFocusMulti.Width2)),max(0.01,abs(CineFocusMulti.Height2)))*CineFocusMulti.FitMode)*(1+CineFocusMulti.Padding))))", },
				Z3 = Input { Value = 2, Expression = "min(CineFocusMulti.MaxZoom,max(1,1/((max(max(0.01,abs(CineFocusMulti.Width3)),max(0.01,abs(CineFocusMulti.Height3)))*(1-CineFocusMulti.FitMode)+min(max(0.01,abs(CineFocusMulti.Width3)),max(0.01,abs(CineFocusMulti.Height3)))*CineFocusMulti.FitMode)*(1+CineFocusMulti.Padding))))", },
				Z4 = Input { Value = 2, Expression = "min(CineFocusMulti.MaxZoom,max(1,1/((max(max(0.01,abs(CineFocusMulti.Width4)),max(0.01,abs(CineFocusMulti.Height4)))*(1-CineFocusMulti.FitMode)+min(max(0.01,abs(CineFocusMulti.Width4)),max(0.01,abs(CineFocusMulti.Height4)))*CineFocusMulti.FitMode)*(1+CineFocusMulti.Padding))))", },
				A2 = Input { Value = 0, Expression = "min(1,max(0,CineFocusMulti.NumTargets-1))", },
				A3 = Input { Value = 0, Expression = "min(1,max(0,CineFocusMulti.NumTargets-2))", },
				A4 = Input { Value = 0, Expression = "min(1,max(0,CineFocusMulti.NumTargets-3))", },
				S2 = Input { Value = 0, Expression = "CineFocusMulti.StartDelay+CineFocusMulti.MoveDur+CineFocusMulti.Hold1", },
				E2 = Input { Value = 0, Expression = "CineFocusMulti.S2+CineFocusMulti.A2*(CineFocusMulti.MoveDur+CineFocusMulti.Hold2)", },
				S3 = Input { Value = 0, Expression = "CineFocusMulti.E2", },
				E3 = Input { Value = 0, Expression = "CineFocusMulti.S3+CineFocusMulti.A3*(CineFocusMulti.MoveDur+CineFocusMulti.Hold3)", },
				S4 = Input { Value = 0, Expression = "CineFocusMulti.E3", },
				E4 = Input { Value = 0, Expression = "CineFocusMulti.S4+CineFocusMulti.A4*(CineFocusMulti.MoveDur+CineFocusMulti.Hold4)", },
				EndT = Input { Value = 0, Expression = "CineFocusMulti.E4", },
				Q1 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.StartDelay)/max(0.05,CineFocusMulti.MoveDur)))", },
				Q2 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.S2)/max(0.05,CineFocusMulti.MoveDur)))", },
				Q3 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.S3)/max(0.05,CineFocusMulti.MoveDur)))", },
				Q4 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.S4)/max(0.05,CineFocusMulti.MoveDur)))", },
				Q5 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.EndT)/max(0.05,CineFocusMulti.MoveDur)))", },
				X1 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.StartDelay)/max(0.05,CineFocusMulti.MoveDur)*(1+CineFocusMulti.PanLead)))", },
				X2 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.S2)/max(0.05,CineFocusMulti.MoveDur)*(1+CineFocusMulti.PanLead)))", },
				X3 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.S3)/max(0.05,CineFocusMulti.MoveDur)*(1+CineFocusMulti.PanLead)))", },
				X4 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.S4)/max(0.05,CineFocusMulti.MoveDur)*(1+CineFocusMulti.PanLead)))", },
				X5 = Input { Value = 0, Expression = "min(1,max(0,(CineFocusMulti.TimeSec-CineFocusMulti.EndT)/max(0.05,CineFocusMulti.MoveDur)*(1+CineFocusMulti.PanLead)))", },
				PZ1 = Input { Value = 0, Expression = "max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.Q1)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.Q1)+0.5*((CineFocusMulti.Q1)*(CineFocusMulti.Q1)*(3-2*(CineFocusMulti.Q1))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.Q1)*(CineFocusMulti.Q1)*(3-2*(CineFocusMulti.Q1)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.Q1)*(CineFocusMulti.Q1)*(CineFocusMulti.Q1)*((CineFocusMulti.Q1)*(6*(CineFocusMulti.Q1)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.Q1)*(CineFocusMulti.Q1)*(3-2*(CineFocusMulti.Q1)))*((CineFocusMulti.Q1)*(CineFocusMulti.Q1)*(3-2*(CineFocusMulti.Q1)))*(3-2*((CineFocusMulti.Q1)*(CineFocusMulti.Q1)*(3-2*(CineFocusMulti.Q1)))))", },
				PZ2 = Input { Value = 0, Expression = "(max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.Q2)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.Q2)+0.5*((CineFocusMulti.Q2)*(CineFocusMulti.Q2)*(3-2*(CineFocusMulti.Q2))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.Q2)*(CineFocusMulti.Q2)*(3-2*(CineFocusMulti.Q2)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.Q2)*(CineFocusMulti.Q2)*(CineFocusMulti.Q2)*((CineFocusMulti.Q2)*(6*(CineFocusMulti.Q2)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.Q2)*(CineFocusMulti.Q2)*(3-2*(CineFocusMulti.Q2)))*((CineFocusMulti.Q2)*(CineFocusMulti.Q2)*(3-2*(CineFocusMulti.Q2)))*(3-2*((CineFocusMulti.Q2)*(CineFocusMulti.Q2)*(3-2*(CineFocusMulti.Q2))))))*CineFocusMulti.A2", },
				PZ3 = Input { Value = 0, Expression = "(max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.Q3)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.Q3)+0.5*((CineFocusMulti.Q3)*(CineFocusMulti.Q3)*(3-2*(CineFocusMulti.Q3))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.Q3)*(CineFocusMulti.Q3)*(3-2*(CineFocusMulti.Q3)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.Q3)*(CineFocusMulti.Q3)*(CineFocusMulti.Q3)*((CineFocusMulti.Q3)*(6*(CineFocusMulti.Q3)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.Q3)*(CineFocusMulti.Q3)*(3-2*(CineFocusMulti.Q3)))*((CineFocusMulti.Q3)*(CineFocusMulti.Q3)*(3-2*(CineFocusMulti.Q3)))*(3-2*((CineFocusMulti.Q3)*(CineFocusMulti.Q3)*(3-2*(CineFocusMulti.Q3))))))*CineFocusMulti.A3", },
				PZ4 = Input { Value = 0, Expression = "(max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.Q4)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.Q4)+0.5*((CineFocusMulti.Q4)*(CineFocusMulti.Q4)*(3-2*(CineFocusMulti.Q4))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.Q4)*(CineFocusMulti.Q4)*(3-2*(CineFocusMulti.Q4)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.Q4)*(CineFocusMulti.Q4)*(CineFocusMulti.Q4)*((CineFocusMulti.Q4)*(6*(CineFocusMulti.Q4)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.Q4)*(CineFocusMulti.Q4)*(3-2*(CineFocusMulti.Q4)))*((CineFocusMulti.Q4)*(CineFocusMulti.Q4)*(3-2*(CineFocusMulti.Q4)))*(3-2*((CineFocusMulti.Q4)*(CineFocusMulti.Q4)*(3-2*(CineFocusMulti.Q4))))))*CineFocusMulti.A4", },
				PR = Input { Value = 0, Expression = "(max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.Q5)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.Q5)+0.5*((CineFocusMulti.Q5)*(CineFocusMulti.Q5)*(3-2*(CineFocusMulti.Q5))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.Q5)*(CineFocusMulti.Q5)*(3-2*(CineFocusMulti.Q5)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.Q5)*(CineFocusMulti.Q5)*(CineFocusMulti.Q5)*((CineFocusMulti.Q5)*(6*(CineFocusMulti.Q5)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.Q5)*(CineFocusMulti.Q5)*(3-2*(CineFocusMulti.Q5)))*((CineFocusMulti.Q5)*(CineFocusMulti.Q5)*(3-2*(CineFocusMulti.Q5)))*(3-2*((CineFocusMulti.Q5)*(CineFocusMulti.Q5)*(3-2*(CineFocusMulti.Q5))))))*CineFocusMulti.AfterLast", },
				PP1 = Input { Value = 0, Expression = "max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.X1)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.X1)+0.5*((CineFocusMulti.X1)*(CineFocusMulti.X1)*(3-2*(CineFocusMulti.X1))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.X1)*(CineFocusMulti.X1)*(3-2*(CineFocusMulti.X1)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.X1)*(CineFocusMulti.X1)*(CineFocusMulti.X1)*((CineFocusMulti.X1)*(6*(CineFocusMulti.X1)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.X1)*(CineFocusMulti.X1)*(3-2*(CineFocusMulti.X1)))*((CineFocusMulti.X1)*(CineFocusMulti.X1)*(3-2*(CineFocusMulti.X1)))*(3-2*((CineFocusMulti.X1)*(CineFocusMulti.X1)*(3-2*(CineFocusMulti.X1)))))", },
				PP2 = Input { Value = 0, Expression = "(max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.X2)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.X2)+0.5*((CineFocusMulti.X2)*(CineFocusMulti.X2)*(3-2*(CineFocusMulti.X2))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.X2)*(CineFocusMulti.X2)*(3-2*(CineFocusMulti.X2)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.X2)*(CineFocusMulti.X2)*(CineFocusMulti.X2)*((CineFocusMulti.X2)*(6*(CineFocusMulti.X2)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.X2)*(CineFocusMulti.X2)*(3-2*(CineFocusMulti.X2)))*((CineFocusMulti.X2)*(CineFocusMulti.X2)*(3-2*(CineFocusMulti.X2)))*(3-2*((CineFocusMulti.X2)*(CineFocusMulti.X2)*(3-2*(CineFocusMulti.X2))))))*CineFocusMulti.A2", },
				PP3 = Input { Value = 0, Expression = "(max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.X3)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.X3)+0.5*((CineFocusMulti.X3)*(CineFocusMulti.X3)*(3-2*(CineFocusMulti.X3))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.X3)*(CineFocusMulti.X3)*(3-2*(CineFocusMulti.X3)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.X3)*(CineFocusMulti.X3)*(CineFocusMulti.X3)*((CineFocusMulti.X3)*(6*(CineFocusMulti.X3)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.X3)*(CineFocusMulti.X3)*(3-2*(CineFocusMulti.X3)))*((CineFocusMulti.X3)*(CineFocusMulti.X3)*(3-2*(CineFocusMulti.X3)))*(3-2*((CineFocusMulti.X3)*(CineFocusMulti.X3)*(3-2*(CineFocusMulti.X3))))))*CineFocusMulti.A3", },
				PP4 = Input { Value = 0, Expression = "(max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.X4)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.X4)+0.5*((CineFocusMulti.X4)*(CineFocusMulti.X4)*(3-2*(CineFocusMulti.X4))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.X4)*(CineFocusMulti.X4)*(3-2*(CineFocusMulti.X4)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.X4)*(CineFocusMulti.X4)*(CineFocusMulti.X4)*((CineFocusMulti.X4)*(6*(CineFocusMulti.X4)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.X4)*(CineFocusMulti.X4)*(3-2*(CineFocusMulti.X4)))*((CineFocusMulti.X4)*(CineFocusMulti.X4)*(3-2*(CineFocusMulti.X4)))*(3-2*((CineFocusMulti.X4)*(CineFocusMulti.X4)*(3-2*(CineFocusMulti.X4))))))*CineFocusMulti.A4", },
				PRP = Input { Value = 0, Expression = "(max(0,1-abs(CineFocusMulti.EaseStyle-0))*(CineFocusMulti.X5)+max(0,1-abs(CineFocusMulti.EaseStyle-1))*(0.5*(CineFocusMulti.X5)+0.5*((CineFocusMulti.X5)*(CineFocusMulti.X5)*(3-2*(CineFocusMulti.X5))))+max(0,1-abs(CineFocusMulti.EaseStyle-2))*((CineFocusMulti.X5)*(CineFocusMulti.X5)*(3-2*(CineFocusMulti.X5)))+max(0,1-abs(CineFocusMulti.EaseStyle-3))*((CineFocusMulti.X5)*(CineFocusMulti.X5)*(CineFocusMulti.X5)*((CineFocusMulti.X5)*(6*(CineFocusMulti.X5)-15)+10))+max(0,1-abs(CineFocusMulti.EaseStyle-4))*(((CineFocusMulti.X5)*(CineFocusMulti.X5)*(3-2*(CineFocusMulti.X5)))*((CineFocusMulti.X5)*(CineFocusMulti.X5)*(3-2*(CineFocusMulti.X5)))*(3-2*((CineFocusMulti.X5)*(CineFocusMulti.X5)*(3-2*(CineFocusMulti.X5))))))*CineFocusMulti.AfterLast", },
				LastZ = Input { Value = 1, Expression = "CineFocusMulti.Z1*pow(CineFocusMulti.Z2/CineFocusMulti.Z1,CineFocusMulti.A2)*pow(CineFocusMulti.Z3/CineFocusMulti.Z2,CineFocusMulti.A3)*pow(CineFocusMulti.Z4/CineFocusMulti.Z3,CineFocusMulti.A4)", },
				LastX = Input { Value = 0.5, Expression = "0.5+(CineFocusMulti.Center1.X-0.5)+(CineFocusMulti.Center2.X-CineFocusMulti.Center1.X)*CineFocusMulti.A2+(CineFocusMulti.Center3.X-CineFocusMulti.Center2.X)*CineFocusMulti.A3+(CineFocusMulti.Center4.X-CineFocusMulti.Center3.X)*CineFocusMulti.A4", },
				LastY = Input { Value = 0.5, Expression = "0.5+(CineFocusMulti.Center1.Y-0.5)+(CineFocusMulti.Center2.Y-CineFocusMulti.Center1.Y)*CineFocusMulti.A2+(CineFocusMulti.Center3.Y-CineFocusMulti.Center2.Y)*CineFocusMulti.A3+(CineFocusMulti.Center4.Y-CineFocusMulti.Center3.Y)*CineFocusMulti.A4", },
				PX = Input { Value = 0.5, Expression = "0.5+(CineFocusMulti.Center1.X-0.5)*CineFocusMulti.PP1+(CineFocusMulti.Center2.X-CineFocusMulti.Center1.X)*CineFocusMulti.PP2+(CineFocusMulti.Center3.X-CineFocusMulti.Center2.X)*CineFocusMulti.PP3+(CineFocusMulti.Center4.X-CineFocusMulti.Center3.X)*CineFocusMulti.PP4+(0.5-CineFocusMulti.LastX)*CineFocusMulti.PRP", },
				PY = Input { Value = 0.5, Expression = "0.5+(CineFocusMulti.Center1.Y-0.5)*CineFocusMulti.PP1+(CineFocusMulti.Center2.Y-CineFocusMulti.Center1.Y)*CineFocusMulti.PP2+(CineFocusMulti.Center3.Y-CineFocusMulti.Center2.Y)*CineFocusMulti.PP3+(CineFocusMulti.Center4.Y-CineFocusMulti.Center3.Y)*CineFocusMulti.PP4+(0.5-CineFocusMulti.LastY)*CineFocusMulti.PRP", },
				ZX = Input { Value = 1, Expression = "pow(CineFocusMulti.Z1,CineFocusMulti.PZ1)*pow(CineFocusMulti.Z2/CineFocusMulti.Z1,CineFocusMulti.PZ2)*pow(CineFocusMulti.Z3/CineFocusMulti.Z2,CineFocusMulti.PZ3)*pow(CineFocusMulti.Z4/CineFocusMulti.Z3,CineFocusMulti.PZ4)*pow(1/CineFocusMulti.LastZ,CineFocusMulti.PR)", },
				MoveActivity = Input { Value = 0, Expression = "max(max(sin(3.14159265*CineFocusMulti.PZ1),sin(3.14159265*CineFocusMulti.PZ2)),max(sin(3.14159265*CineFocusMulti.PZ3),max(sin(3.14159265*CineFocusMulti.PZ4),sin(3.14159265*CineFocusMulti.PR))))", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "GuideMerge4", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				ZoomXf = Transform {
					Inputs = {
						Center = Input { Value = { 0.5, 0.5 }, },
						Pivot = Input {
							Value = { 0.5, 0.5 },
							Expression = "Point(0.5+(CineFocusMulti.PX-0.5)*(1-CineFocusMulti.EditMode),0.5+(CineFocusMulti.PY-0.5)*(1-CineFocusMulti.EditMode))",
						},
						Size = Input { Value = 1, Expression = "pow(CineFocusMulti.ZX,1-CineFocusMulti.EditMode)", },
						MotionBlur = Input { Value = 0, Expression = "CineFocusMulti.MotionBlur", },
						Quality = Input { Value = 8, Expression = "CineFocusMulti.BlurSamples", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				SoftBlurOp = Blur {
					Inputs = {
						Input = Input { SourceOp = "ZoomXf", Source = "Output", },
						Size = Input { Value = 0, Expression = "CineFocusMulti.SoftBlur*CineFocusMulti.MoveActivity", },
					},
					ViewInfo = OperatorInfo { Pos = { 165, 0 } },
				},
				GuideColor = Background {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						TopLeftRed = Input { Value = 1, },
						TopLeftGreen = Input { Value = 0.85, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 1, },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 140 } },
				},
				GuideRect1 = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.004, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0.4, },
						Height = Input { Value = 0.4, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 140 } },
				},
				GuideRect2 = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.004, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.35, 0.55 }, },
						Width = Input { Value = 0.25, },
						Height = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 200 } },
				},
				GuideRect3 = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.004, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.65, 0.45 }, },
						Width = Input { Value = 0.25, },
						Height = Input { Value = 0.25, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 260 } },
				},
				GuideRect4 = RectangleMask {
					Inputs = {
						Solid = Input { Value = 0, },
						BorderWidth = Input { Value = 0.004, },
						MaskWidth = Input { Value = 1920, },
						MaskHeight = Input { Value = 1080, },
						PixelAspect = Input { Value = { 1, 1 }, },
						UseFrameFormatSettings = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						Width = Input { Value = 0.2, },
						Height = Input { Value = 0.2, },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 320 } },
